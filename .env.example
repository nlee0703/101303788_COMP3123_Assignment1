# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or local). The app always uses the
# database "comp3123_assignment1", whatever database name is in the URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/

# Long random string used to sign JWTs
JWT_SECRET=replace-with-a-long-random-secret

# How long a login token stays valid (e.g. 1h, 30m)
JWT_EXPIRES_IN=1h

PORT=3000
